--in this code we are selecting indivudals that have their city as Boston

  SELECT * From PATIENTS
  Where city = 'Boston';

--in this code we are selecting indivudals that are less than 40 yrs old 

  SELECT * From PATIENTS
  WHERE age < 40;

--in the next couple lines of code we are finding the average, min/max ages within out sample data 

  SELECT avg(age) from PATIENTS;
  
  Select count(*) From PATIENTS;
  
  Select min(age) from PATIENTS;
  
  Select max(age) from PATIENTS;

 --in this code we are grouping indivduals by city and then placing their average age in descending order

  SELECT city, avg(age) average_age
  from PATIENTS
  group by city
  Order by average_age DESC;

--in this code we are finding out how many distinct cities there are   
  Select Count(Distinct city) From PATIENTS;

